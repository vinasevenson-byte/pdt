{
  "database": {
    "rules": "database.rules.json"
  },
  "functions": [
    {
      "source": "services/functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "database.rules.json",
      "seed.json",
      "setRole.js",
      "motorRepasse.test.js",
      "package.json",
      "package-lock.json",
      "README.md",
      "LEIA-ME-PRIMEIRO.md",
      "*.log",
      "**/.*",
      "**/node_modules/**",
      "apps/**",
      "packages/**",
      "services/**",
      "functions/**",
      "firebase/**",
      "docs/**",
      "legacy/**",
      "scripts/**",
      "tests/**",
      "backups/**",
      "Financeiro_Disk/**",
      "Financeiro_DiskIngressos/**",
      "Portal_Produtor/**",
      "Portal_Produtor_DiskIngressos/**",
      "Nucleo_Financeiro_Compartilhado/**"
    ]
  }
}
