{
  "name": "diskingressos-hub-repasses",
  "version": "2.0.0",
  "private": true,
  "description": "Monorepo Hub de Repasses DiskIngressos — Financeiro, Produtor, Motor Puro, Functions e Serviço Java (Firebase RTDB diskingressos-62591)",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/functions"
  ],
  "scripts": {
    "test": "node --test packages/motor-repasse/test/motorRepasse.test.js packages/motor-repasse/test/novosModulos.test.js tests/base-original.test.mjs tests/security.test.mjs motorRepasse.test.js",
    "test:motor": "node --test packages/motor-repasse/test/motorRepasse.test.js packages/motor-repasse/test/novosModulos.test.js",
    "test:security": "node --test tests/security.test.mjs tests/base-original.test.mjs",
    "legado:visualizar": "node scripts/visualizar-legado.mjs",
    "new:module": "node scripts/new-module.js",
    "set-role": "node scripts/setRole.js",
    "dev:financeiro": "npm --workspace=@diskingressos/app-financeiro run dev",
    "dev:produtor": "npm --workspace=@diskingressos/app-produtor run dev",
    "build:financeiro": "npm --workspace=@diskingressos/app-financeiro run build",
    "build:produtor": "npm --workspace=@diskingressos/app-produtor run build"
  }
}
